#!/bin/bash
# tmux-kill-pane — safely kill a tmux pane, refusing (or asking) if the pane
# has long-running protected processes that would be lost.
#
# This is the "kill" counterpart to tmux-restart-pane. Whereas restart-pane
# replaces a process with a new one, kill-pane is for tearing down a pane
# entirely (e.g. an idle window you no longer need, or a hung shell).
#
# WHY THIS EXISTS
#   Plain `tmux kill-pane -t target` silently destroys whatever was running
#   in that pane — including a multi-hour training job or a live server.
#   This wrapper refuses to kill a pane whose process tree contains
#   protected processes (see ../config PROTECTED_RE) unless you pass
#   --force.
#
# USAGE
#   tmux-kill-pane <target>                  # refuse if protected proc found
#   tmux-kill-pane <target> --force          # kill anyway
#   tmux-kill-pane <target> --dry-run        # show what would happen
#   tmux-kill-pane <target> --allow <pat>    # allow kill if pattern matches
#                                            # (e.g. --allow 'train.py')
#
# EXIT CODES
#   0  Killed (or dry-run)
#   2  Usage error
#   3  Target not found
#   6  Refused: protected processes detected (use --force)
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── Load user config (if/then form: `[[ ]] &&` would trip set -e) ─────────
CONFIG_FILE="${SCRIPT_DIR}/../config"
if [[ -f "$CONFIG_FILE" ]]; then source "$CONFIG_FILE"; fi
PROTECTED_RE="${TMUX_CONTROL_PROTECTED_RE:-${PROTECTED_RE:-train\\.py|trainer|scheduler|monitor}}"

TARGET=""
FORCE=0
DRY_RUN=0
ALLOW_PATTERNS=()

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

# Strip obvious shell redirect residue
is_redirect_residue() {
    case "$1" in
        '2>&1'|'>&1'|'&>'|'>'|'<'|'1>'|'2>'|'&') return 0;;
        '|'*|'||'*|'&&'*) return 0;;
        '') return 0;;
    esac
    return 1
}

CLEAN_ARGS=()
for a in "$@"; do
    if is_redirect_residue "$a"; then continue; fi
    CLEAN_ARGS+=("$a")
done
set -- "${CLEAN_ARGS[@]}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force)  FORCE=1; shift;;
        --dry-run) DRY_RUN=1; shift;;
        --allow)  [[ $# -ge 2 && "$2" != -* ]] || { echo "ERROR: --allow requires a pattern value" >&2; exit 2; }
                  ALLOW_PATTERNS+=("$2"); shift 2;;
        --help|-h) usage;;
        -*|--)    shift;;
        *)
            # Reject bare "1"/"2" as TARGET (leaked from "2>&1" residue).
            if [[ -z "$TARGET" && ! "$1" =~ ^[12]$ ]]; then TARGET="$1"; shift;
            else shift; fi
            ;;
    esac
done

[[ -n "$TARGET" ]] || { echo "ERROR: target required" >&2; exit 2; }

if ! tmux list-panes -t "$TARGET" >/dev/null 2>&1; then
    echo "ERROR: tmux target '$TARGET' not found" >&2
    exit 3
fi

# ── Helper: walk process tree from the pane's shell pid (INCLUDES the
# pane_pid itself: when a pane is started as `tmux new-session -d
# 'python train.py'`, the shell execs into python and pane_pid IS the job;
# children-only walks report an empty tree and the kill guard silently
# passes. v2.0.0 fix) ───────────────────
descendants_of_pane() {
    local pane_target="$1"
    local pane_pid
    pane_pid=$(tmux list-panes -t "$pane_target" -F '#{pane_pid}' 2>/dev/null | head -1)
    [[ -n "$pane_pid" ]] || return 0

    local psfile
    psfile=$(mktemp)
    ps -eo pid,ppid,etime,args > "$psfile" 2>/dev/null

    python3 - "$pane_pid" "$psfile" <<'PYEOF'
import sys
root = int(sys.argv[1])
psfile = sys.argv[2]
children = {}
info = {}
with open(psfile) as f:
    for line in f:
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        try:
            pid, ppid = int(parts[0]), int(parts[1])
        except ValueError:
            continue
        info[pid] = (parts[2], parts[3].rstrip())
        children.setdefault(ppid, []).append(pid)

root_info = info.get(root)
if root_info:
    print(f"{root} {root_info[0]} {root_info[1]}")

queue = [root]
seen = {root}
while queue:
    cur = queue.pop(0)
    for pid in children.get(cur, []):
        etime, args = info.get(pid, ("?", ""))
        print(f"{pid} {etime} {args}")
        queue.append(pid)
PYEOF
    rm -f "$psfile"
}

# ── Pre-flight: check what's running in the pane ─────────────────────────
DESC=$(descendants_of_pane "$TARGET" || true)
PROTECTED_IN_PANE=$(echo "$DESC" | grep -E "$PROTECTED_RE" 2>/dev/null || true)

# Apply --allow patterns (if any protected process matches an allow pattern,
# we treat it as user-approved and skip the refusal).
if [[ -n "$PROTECTED_IN_PANE" && ${#ALLOW_PATTERNS[@]} -gt 0 ]]; then
    FILTERED=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        MATCHED=0
        for pat in "${ALLOW_PATTERNS[@]}"; do
            if echo "$line" | grep -qE "$pat"; then
                MATCHED=1
                break
            fi
        done
        [[ "$MATCHED" == "1" ]] || FILTERED+="$line"$'\n'
    done <<< "$PROTECTED_IN_PANE"
    PROTECTED_IN_PANE="$FILTERED"
fi

echo "[kill-pane] target=$TARGET"
if [[ -n "$DESC" ]]; then
    echo "[kill-pane] processes currently in pane:"
    echo "$DESC" | head -10 | sed 's/^/    /' | cut -c1-160
    [[ $(echo "$DESC" | wc -l) -gt 10 ]] && echo "    ... ($(($(echo "$DESC" | wc -l) - 10)) more)"
else
    echo "[kill-pane] pane has no child processes (idle shell)"
fi

if [[ "$DRY_RUN" == "1" ]]; then
    echo ""
    echo "[kill-pane] DRY RUN — would run: tmux kill-pane -t $TARGET"
    if [[ -n "$PROTECTED_IN_PANE" ]]; then
        echo "[kill-pane] DRY RUN — WARNING: protected processes would be killed:"
        echo "$PROTECTED_IN_PANE" | head -5 | sed 's/^/    /' | cut -c1-160
    fi
    exit 0
fi

if [[ -n "$PROTECTED_IN_PANE" && "$FORCE" != "1" ]]; then
    echo ""
    echo "[kill-pane] REFUSED: protected processes detected in pane:"
    echo "$PROTECTED_IN_PANE" | head -5 | sed 's/^/    /' | cut -c1-160
    echo ""
    echo "[kill-pane] To proceed anyway: tmux-kill-pane $TARGET --force"
    echo "[kill-pane] Or to allow specific patterns: tmux-kill-pane $TARGET --allow 'train.py'"
    exit 6
fi

tmux kill-pane -t "$TARGET"
echo "[kill-pane] killed: $TARGET"
